# Copy to .env.backend for local development. These values are synthetic and local-only.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
APP_BASE_URL=http://127.0.0.1:3000
LOG_LEVEL=debug
TRUST_PROXY=false
OPENAPI_ENABLED=true

BACKEND_POSTGRES_DB=mymoneymap_dev
BACKEND_POSTGRES_USER=mymoneymap_dev
BACKEND_POSTGRES_PASSWORD=replace-with-local-only-password
BACKEND_POSTGRES_PORT=5433
DATABASE_URL=postgresql://mymoneymap_dev:replace-with-local-only-password@127.0.0.1:5433/mymoneymap_dev

BACKEND_REDIS_PORT=6380
REDIS_URL=redis://127.0.0.1:6380
