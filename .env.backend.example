# Copy to .env.backend for local development. These values are synthetic and local-only.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
APP_BASE_URL=http://127.0.0.1:3000
LOG_LEVEL=debug
TRUST_PROXY=false
OPENAPI_ENABLED=true
HTTP_JSON_BODY_LIMIT_BYTES=2097152
HTTP_REQUEST_TIMEOUT_MS=15000
HTTP_HEADERS_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_RATE_LIMIT_WINDOW_SECONDS=60
HTTP_RATE_LIMIT_MAX_REQUESTS=300
HTTP_ADMIN_RATE_LIMIT_MAX_REQUESTS=120
OPERATIONS_METRICS_ENABLED=false
OPERATIONS_METRICS_TOKEN=
SENTRY_ENABLED=false
SENTRY_PRODUCTION_APPROVED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0

BACKEND_POSTGRES_DB=mymoneymap_dev
BACKEND_POSTGRES_USER=mymoneymap_dev
BACKEND_POSTGRES_PASSWORD=replace-with-local-only-password
BACKEND_POSTGRES_PORT=5433
DATABASE_URL=postgresql://mymoneymap_dev:replace-with-local-only-password@127.0.0.1:5433/mymoneymap_dev
DATABASE_MIGRATION_URL=postgresql://mymoneymap_dev:replace-with-local-only-password@127.0.0.1:5433/mymoneymap_dev
DATABASE_TLS_MODE=disable
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=2000
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_MAX_LIFETIME_SECONDS=300

BACKEND_REDIS_PORT=6380
REDIS_URL=redis://127.0.0.1:6380
REDIS_CONNECT_TIMEOUT_MS=2000
FX_REFRESH_ENABLED=false
RECURRENCE_ENABLED=true
FX_PROVIDER_TIMEOUT_MS=5000
SECURITIES_MARKET_DATA_ENABLED=false
SECURITIES_MARKET_DATA_PRODUCTION_APPROVED=false
SECURITIES_PROVIDER=disabled
SECURITIES_PROVIDER_TIMEOUT_MS=5000
FINNHUB_BASE_URL=https://finnhub.io/api/v1
EMAIL_DELIVERY_ENABLED=false
EMAIL_DELIVERY_PRODUCTION_APPROVED=false
EMAIL_PROVIDER=disabled
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=MyMoneyMap
EMAIL_REPLY_TO_ADDRESS=
POSTMARK_SERVER_TOKEN=
POSTMARK_BASE_URL=https://api.postmarkapp.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# none, starttls (usually port 587), or tls (usually port 465)
SMTP_SECURITY=starttls
SMTP_CONNECTION_TIMEOUT_MS=15000
# No production defaults: enable only after the owner supplies both TTL values.
PRIVACY_EXPORTS_ENABLED=false
PRIVACY_EXPORT_STORAGE_PROVIDER=disabled
PRIVACY_EXPORT_S3_BUCKET=
PRIVACY_EXPORT_S3_REGION=
PRIVACY_EXPORT_EXPIRY_SECONDS=
PRIVACY_EXPORT_SIGNED_URL_SECONDS=
# Legacy migration is rehearsal-only by default. Use a dedicated PostgreSQL role
# with CONNECT and SELECT privileges only; never reuse the target application role.
LEGACY_MIGRATION_ENABLED=false
LEGACY_MIGRATION_MODE=rehearsal
LEGACY_MIGRATION_CUTOVER_APPROVED=false
LEGACY_DATABASE_URL=
# FINNHUB_API_KEY=use-a-local-secret-store

# Identity/security policy. Use independent random values in every environment.
SESSION_SECRET=replace-with-at-least-32-random-characters
# Base64-encoded 32-byte key. Generate and store it independently from session credentials.
SETTINGS_ENCRYPTION_KEY=cmVwbGFjZS13aXRoLWV4YWN0bHktMzItYnl0ZXMhISE=
ACCOUNT_RECOVERY_TTL_SECONDS=3600
SESSION_COOKIE_NAME=mymoneymap.sid
SESSION_IDLE_TTL_SECONDS=1800
SESSION_ABSOLUTE_TTL_SECONDS=43200
REMEMBER_SESSION_ABSOLUTE_TTL_SECONDS=2592000
EMAIL_VERIFICATION_TTL_SECONDS=86400
EMAIL_VERIFICATION_RESEND_SECONDS=300
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_IP_MAX_ATTEMPTS=25
WEBAUTHN_RP_NAME=MyMoneyMap
WEBAUTHN_RP_ID=localhost
WEBAUTHN_EXPECTED_ORIGINS=http://localhost:4200
WEBAUTHN_CHALLENGE_TTL_SECONDS=300
