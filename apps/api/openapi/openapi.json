    "/api/v1/journal/entries": {
      "post": {
        "operationId": "LedgerController_create",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateJournalEntryDto" },
              "examples": {
                "income": {
                  "summary": "External income to the default cash account",
                  "value": {
                    "economicType": "external_income",
                    "amount": "1000.00",
                    "currency": "HUF",
                    "postedOn": "2026-07-29",
                    "note": "Synthetic salary fixture"
                  }
                },
                "transfer": {
                  "summary": "Internal transfer between owned accounts",
                  "value": {
                    "economicType": "internal_transfer",
                    "amount": "300.00",
                    "currency": "HUF",
                    "postedOn": "2026-07-29",
                    "sourceAccountId": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
                    "destinationAccountId": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/JournalEntryResponseDto" }
              }
            }
          },
          "422": { "description": "Financial or journal semantic validation failed" }
        },
        "security": [{ "cookie": [] }],
        "summary": "Post an immutable balanced journal entry",
        "tags": ["Ledger"]
      },
      "get": {
        "operationId": "LedgerController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/JournalListResponseDto" }
              }
            }
          }
        },
        "security": [{ "cookie": [] }],
        "summary": "List posted journal entries using stable cursor and date filters",
        "tags": ["Ledger"]
      }
    },
    "/api/v1/journal/entries/{id}/reversals": {
      "post": {
        "operationId": "LedgerController_reverse",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/JournalEntryResponseDto" }
              }
            }
          },
          "404": { "description": "The owned journal entry was not found" },
          "409": { "description": "The entry was already reversed or is a reversal" }
        },
        "security": [{ "cookie": [] }],
        "summary": "Reverse a posted journal entry without deleting history",
        "tags": ["Ledger"]
      }
    },
    "/api/v1/journal/entries/{id}/corrections": {
      "post": {
        "operationId": "LedgerController_correct",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/JournalCorrectionResponseDto" }
              }
            }
          },
          "404": { "description": "The owned journal entry was not found" },
          "409": { "description": "The entry was already corrected or reversed" }
        },
        "security": [{ "cookie": [] }],
        "summary": "Atomically reverse and replace a posted journal entry",
        "tags": ["Ledger"]
      }
    },
    "/api/v1/health/live": {
      "get": {
        "operationId": "HealthController_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/LivenessResponse" } }
            }
          },
          "500": {
            "description": "",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          }
        },
        "summary": "Report that the API process is alive",
        "tags": ["health"]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "HealthController_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ReadinessResponse" } }
            }
          },
          "500": {
            "description": "",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "503": {
            "description": "",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          }
        },
        "summary": "Verify required PostgreSQL and Redis dependencies",
        "tags": ["health"]
      }
    }
  },
  "info": {
    "title": "MyMoneyMap API",
    "description": "Versioned backend contract for MyMoneyMap",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": { "cookie": { "type": "apiKey", "in": "cookie", "name": "mymoneymap.sid" } },
    "schemas": {
      "UpdateCurrentUserDto": {
        "type": "object",
        "properties": {
          "fullName": { "type": "string", "example": "Ada Example" },
          "dateOfBirth": { "type": "string", "format": "date", "example": "1990-01-15" },
          "desiredLanguage": { "type": "string", "enum": ["en", "hu", "es"], "example": "en" }
        }
      },
      "UpdateThemeDto": {
        "type": "object",
        "properties": {
          "theme": {
            "type": "string",
            "enum": [
              "polar-quartz",
              "verdant-horizon",
              "celestial-tide",
              "blush-nocturne",
              "ember-vanguard",
              "lilac-eclipse",
              "solaris-bloom",
              "dune-mirage"
            ],
            "example": "verdant-horizon"
          }
        },
        "required": ["theme"]
      },
      "CompleteTutorialDto": {
        "type": "object",
        "properties": {
          "tutorialCompleted": {
            "type": "boolean",
            "enum": [true],
            "description": "Completes the post-onboarding tutorial. False is not a valid transition."
          }
        },
        "required": ["tutorialCompleted"]
      },
      "ResourceEntitlementDto": {
        "type": "object",
        "properties": {
          "allowed": { "type": "boolean" },
          "limit": {
            "type": "number",
            "nullable": true,
            "description": "Null means unlimited only when allowed is true; otherwise the resource is unavailable."
          }
        },
        "required": ["allowed", "limit"]
      },
      "ResourceEntitlementsDto": {
        "type": "object",
        "properties": {
          "currencies": { "$ref": "#/components/schemas/ResourceEntitlementDto" },
          "activeGoals": { "$ref": "#/components/schemas/ResourceEntitlementDto" },
          "activeLoans": { "$ref": "#/components/schemas/ResourceEntitlementDto" },
          "categories": { "$ref": "#/components/schemas/ResourceEntitlementDto" },
          "activeScheduledItems": { "$ref": "#/components/schemas/ResourceEntitlementDto" }
        },
        "required": [
          "currencies",
          "activeGoals",
          "activeLoans",
          "categories",
          "activeScheduledItems"
        ]
      },
      "EntitlementsDto": {
        "type": "object",
        "properties": {
          "personalFinanceAccess": { "type": "boolean" },
          "administration": { "type": "boolean" },
          "cashFlowRuleEditing": { "type": "boolean" },
          "resources": { "$ref": "#/components/schemas/ResourceEntitlementsDto" }
        },
        "required": ["personalFinanceAccess", "administration", "cashFlowRuleEditing", "resources"]
      },
      "CurrentUserResponseDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" },
          "fullName": { "type": "string", "example": "Ada Example" },
          "dateOfBirth": { "type": "string", "format": "date", "example": "1990-01-15" },
          "role": { "type": "string", "enum": ["free", "premium", "admin"] },
          "emailVerified": { "type": "boolean" },
          "theme": {
            "type": "string",
            "enum": [
              "polar-quartz",
              "verdant-horizon",
              "celestial-tide",
              "blush-nocturne",
              "ember-vanguard",
              "lilac-eclipse",
              "solaris-bloom",
              "dune-mirage"
            ]
          },
          "desiredLanguage": { "type": "string", "enum": ["en", "hu", "es"] },
          "entitlements": { "$ref": "#/components/schemas/EntitlementsDto" }
        },
        "required": [
          "id",
          "email",
          "fullName",
          "dateOfBirth",
          "role",
          "emailVerified",
          "theme",
          "desiredLanguage",
          "entitlements"
        ]
      },
      "ThemePreferencesResponseDto": {
        "type": "object",
        "properties": {
          "theme": {
            "type": "string",
            "enum": [
              "polar-quartz",
              "verdant-horizon",
              "celestial-tide",
              "blush-nocturne",
              "ember-vanguard",
              "lilac-eclipse",
              "solaris-bloom",
              "dune-mirage"
            ]
          },
          "supportedThemes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "polar-quartz",
                "verdant-horizon",
                "celestial-tide",
                "blush-nocturne",
                "ember-vanguard",
                "lilac-eclipse",
                "solaris-bloom",
                "dune-mirage"
              ]
            }
          }
        },
        "required": ["theme", "supportedThemes"]
      },
      "OnboardingResponseDto": {
        "type": "object",
        "properties": {
          "currentStep": { "type": "number", "minimum": 0, "maximum": 6 },
          "next": {
            "type": "string",
            "enum": ["theme", "rules", "currencies", "categories", "income", "tutorial", "complete"]
          },
          "onboardingComplete": { "type": "boolean" },
          "tutorialRequired": { "type": "boolean" },
          "tutorialCompleted": { "type": "boolean" }
        },
        "required": [
          "currentStep",
          "next",
          "onboardingComplete",
          "tutorialRequired",
          "tutorialCompleted"
        ]
      },
      "CreateJournalEntryDto": {
        "type": "object",
        "properties": {
          "economicType": {
            "type": "string",
            "enum": [
              "external_income",
              "external_expense",
              "internal_transfer",
              "adjustment",
              "fee",
              "interest",
              "dividend"
            ],
            "example": "external_expense"
          },
          "amount": {
            "type": "string",
            "example": "125.50",
            "description": "Positive exact base-10 decimal string; direction comes from economicType."
          },
          "currency": { "type": "string", "example": "HUF", "pattern": "^[A-Z]{3}$" },
          "postedOn": { "type": "string", "format": "date", "example": "2026-07-29" },
          "effectiveAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-07-29T10:15:00.000Z"
          },
          "accountId": { "type": "string", "format": "uuid" },
          "sourceAccountId": { "type": "string", "format": "uuid" },
          "destinationAccountId": { "type": "string", "format": "uuid" },
          "adjustmentDirection": { "type": "string", "enum": ["increase", "decrease"] },
          "categoryId": {
            "type": "string",
            "format": "uuid",
            "description": "Reserved nullable linkage for the Step 08 owned-category model."
          },
          "note": { "type": "string", "maxLength": 1000 }
        },
        "required": ["economicType", "amount", "currency", "postedOn"]
      },
      "CorrectJournalEntryDto": {
        "type": "object",
        "properties": {
          "economicType": {
            "type": "string",
            "enum": [
              "external_income",
              "external_expense",
              "internal_transfer",
              "adjustment",
              "fee",
              "interest",
              "dividend"
            ],
            "example": "external_expense"
          },
          "amount": {
            "type": "string",
            "example": "125.50",
            "description": "Positive exact base-10 decimal string; direction comes from economicType."
          },
          "currency": { "type": "string", "example": "HUF", "pattern": "^[A-Z]{3}$" },
          "postedOn": { "type": "string", "format": "date", "example": "2026-07-29" },
          "effectiveAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-07-29T10:15:00.000Z"
          },
          "accountId": { "type": "string", "format": "uuid" },
          "sourceAccountId": { "type": "string", "format": "uuid" },
          "destinationAccountId": { "type": "string", "format": "uuid" },
          "adjustmentDirection": { "type": "string", "enum": ["increase", "decrease"] },
          "categoryId": {
            "type": "string",
            "format": "uuid",
            "description": "Reserved nullable linkage for the Step 08 owned-category model."
          },
          "note": { "type": "string", "maxLength": 1000 }
        },
        "required": ["economicType", "amount", "currency", "postedOn"]
      },
      "ReverseJournalEntryDto": {
        "type": "object",
        "properties": {
          "postedOn": { "type": "string", "format": "date", "example": "2026-07-30" },
          "effectiveAt": { "type": "string", "format": "date-time" },
          "note": { "type": "string", "maxLength": 1000 }
        },
        "required": ["postedOn"]
      },
      "JournalSourceResponseDto": {
        "type": "object",
        "properties": {
          "module": {
            "type": "string",
            "enum": [
              "manual",
              "scheduling",
              "goals",
              "emergency_fund",
              "loans",
              "investments",
              "securities",
              "migration"
            ]
          },
          "referenceId": { "type": "string", "format": "uuid", "nullable": true }
        },
        "required": ["module", "referenceId"]
      },
      "JournalLegResponseDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "accountId": { "type": "string", "format": "uuid", "nullable": true },
          "side": { "type": "string", "enum": ["debit", "credit"] },
          "amount": { "type": "string", "example": "125.50" },
          "currency": { "type": "string", "example": "HUF" }
        },
        "required": ["id", "accountId", "side", "amount", "currency"]
      },
      "JournalEntryResponseDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "economicType": {
            "type": "string",
            "enum": [
              "external_income",
              "external_expense",
              "internal_transfer",
              "adjustment",
              "fee",
              "interest",
              "dividend",
              "loan_repayment",
              "trade_cash"
            ]
          },
          "categoryId": { "type": "string", "format": "uuid", "nullable": true },
          "note": { "type": "string", "nullable": true },
          "source": { "$ref": "#/components/schemas/JournalSourceResponseDto" },
          "postedOn": { "type": "string", "format": "date" },
          "effectiveAt": { "type": "string", "format": "date-time" },
          "createdAt": { "type": "string", "format": "date-time" },
          "actorUserId": { "type": "string", "format": "uuid" },
          "reversesEntryId": { "type": "string", "format": "uuid", "nullable": true },
          "replacesEntryId": { "type": "string", "format": "uuid", "nullable": true },
          "legs": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/JournalLegResponseDto" }
          }
        },
        "required": [
          "id",
          "economicType",
          "categoryId",
          "note",
          "source",
          "postedOn",
          "effectiveAt",
          "createdAt",
          "actorUserId",
          "reversesEntryId",
          "replacesEntryId",
          "legs"
        ]
      },
      "JournalCorrectionResponseDto": {
        "type": "object",
        "properties": {
          "reversal": { "$ref": "#/components/schemas/JournalEntryResponseDto" },
          "replacement": { "$ref": "#/components/schemas/JournalEntryResponseDto" }
        },
        "required": ["reversal", "replacement"]
      },
      "JournalListResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/JournalEntryResponseDto" }
          },
          "nextCursor": { "type": "string", "nullable": true }
        },
        "required": ["items", "nextCursor"]
      },
      "ApiViolationResponse": {
        "type": "object",
        "properties": {
          "field": { "type": "string", "example": "fieldName" },
          "code": { "type": "string", "example": "isString" },
          "message": { "type": "string", "example": "must be a valid value" }
        },
        "required": ["field", "code", "message"]
      },
      "ApiErrorBodyResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_FAILED",
              "BAD_REQUEST",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "NOT_FOUND",
              "CONFLICT",
              "UNPROCESSABLE_ENTITY",
              "TOO_MANY_REQUESTS",
              "IDEMPOTENCY_CONFLICT",
              "IDEMPOTENCY_IN_PROGRESS",
              "SERVICE_NOT_READY",
              "SERVICE_UNAVAILABLE",
              "INTERNAL_SERVER_ERROR"
            ],
            "example": "VALIDATION_FAILED"
          },
          "message": { "type": "string", "example": "Request validation failed" },
          "requestId": {
            "type": "string",
            "example": "4d69ed37-7f7f-4318-8b9a-62b3a2469ed5",
            "format": "uuid"
          },
          "violations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ApiViolationResponse" }
          }
        },
        "required": ["code", "message", "requestId"]
      },
      "ApiErrorResponse": {
        "type": "object",
        "properties": { "error": { "$ref": "#/components/schemas/ApiErrorBodyResponse" } },
        "required": ["error"]
      },
      "LivenessResponse": {
        "type": "object",
        "properties": { "status": { "type": "string", "example": "ok" } },
        "required": ["status"]
      },
      "DependencyStatusResponse": {
        "type": "object",
        "properties": {
          "postgresql": { "type": "string", "example": "up", "enum": ["up"] },
          "redis": { "type": "string", "example": "up", "enum": ["up"] }
        },
        "required": ["postgresql", "redis"]
      },
      "ReadinessResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "ready" },
          "dependencies": { "$ref": "#/components/schemas/DependencyStatusResponse" }
        },
        "required": ["status", "dependencies"]
      }
    }
  }
}
