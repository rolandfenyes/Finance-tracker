        "summary": "Register an account and issue email verification",
        "tags": ["Identity"]
      }
    },
    "/api/v1/auth/email-verifications": {
      "post": {
        "operationId": "IdentityController_verify",
        "parameters": [],
        "responses": { "204": { "description": "" } },
        "tags": ["Identity"]
      }
    },
    "/api/v1/auth/email-verification-requests": {
      "post": {
        "operationId": "IdentityController_requestVerification",
        "parameters": [],
        "responses": { "202": { "description": "" } },
        "tags": ["Identity"]
      }
    },
    "/api/v1/auth/sessions": {
      "post": {
        "operationId": "IdentityController_login",
        "parameters": [],
        "responses": { "204": { "description": "" } },
        "tags": ["Identity"]
      }
    },
    "/api/v1/auth/session": {
      "delete": {
        "operationId": "IdentityController_logout",
        "parameters": [],
        "responses": { "204": { "description": "" } },
        "security": [{ "cookie": [] }],
        "tags": ["Identity"]
      }
    },
    "/api/v1/users/me": {
      "get": {
        "operationId": "IdentityController_currentUser",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserResponseDto"
                }
              }
            }
          }
        },
        "security": [{ "cookie": [] }],
        "tags": ["Identity"]
      }
    },
    "/api/v1/users/me/password": {
      "put": {
        "operationId": "IdentityController_changePassword",
        "parameters": [],
        "responses": { "204": { "description": "" } },
        "security": [{ "cookie": [] }],
        "tags": ["Identity"]
      }
    },
    "/api/v1/auth/passkeys/registration-options": {
      "post": {
        "operationId": "IdentityController_registrationOptions",
        "parameters": [],
        "responses": { "201": { "description": "" } },
        "security": [{ "cookie": [] }],
        "tags": ["Identity"]
      }
    },
    "/api/v1/auth/passkeys": {
      "post": {
        "operationId": "IdentityController_registerPasskey",
        "parameters": [],
        "responses": { "201": { "description": "" } },
        "security": [{ "cookie": [] }],
        "tags": ["Identity"]
      }
    },
    "/api/v1/auth/passkey-sessions/options": {
      "post": {
        "operationId": "IdentityController_passkeyOptions",
        "parameters": [],
        "responses": { "201": { "description": "" } },
        "tags": ["Identity"]
      }
    },
    "/api/v1/auth/passkey-sessions": {
      "post": {
        "operationId": "IdentityController_passkeyLogin",
        "parameters": [],
        "responses": { "204": { "description": "" } },
        "tags": ["Identity"]
      }
    },
    "/api/v1/auth/passkeys/{id}": {
      "delete": {
        "operationId": "IdentityController_deletePasskey",
        "parameters": [],
        "responses": { "204": { "description": "" } },
        "security": [{ "cookie": [] }],
        "tags": ["Identity"]
      }
    },
    "/api/v1/health/live": {
      "get": {
        "operationId": "HealthController_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LivenessResponse" }
              }
            }
          },
          "500": {
            "description": "",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiErrorResponse" }
              }
            }
          }
        },
        "summary": "Report that the API process is alive",
        "tags": ["health"]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "HealthController_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReadinessResponse" }
              }
            }
          },
          "500": {
            "description": "",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiErrorResponse" }
              }
            }
          },
          "503": {
            "description": "",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiErrorResponse" }
              }
            }
          }
        },
        "summary": "Verify required PostgreSQL and Redis dependencies",
        "tags": ["health"]
      }
    }
  },
  "info": {
    "title": "MyMoneyMap API",
    "description": "Versioned backend contract for MyMoneyMap",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": { "type": "apiKey", "in": "cookie", "name": "mymoneymap.sid" }
    },
    "schemas": {
      "CurrentUserResponseDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" },
          "role": { "type": "string", "enum": ["free", "premium", "admin"] },
          "emailVerified": { "type": "boolean" }
        },
        "required": ["id", "email", "role", "emailVerified"]
      },
      "ApiViolationResponse": {
        "type": "object",
        "properties": {
          "field": { "type": "string", "example": "fieldName" },
          "code": { "type": "string", "example": "isString" },
          "message": { "type": "string", "example": "must be a valid value" }
        },
        "required": ["field", "code", "message"]
      },
      "ApiErrorBodyResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_FAILED",
              "BAD_REQUEST",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "NOT_FOUND",
              "CONFLICT",
              "UNPROCESSABLE_ENTITY",
              "TOO_MANY_REQUESTS",
              "IDEMPOTENCY_CONFLICT",
              "IDEMPOTENCY_IN_PROGRESS",
              "SERVICE_NOT_READY",
              "SERVICE_UNAVAILABLE",
              "INTERNAL_SERVER_ERROR"
            ],
            "example": "VALIDATION_FAILED"
          },
          "message": {
            "type": "string",
            "example": "Request validation failed"
          },
          "requestId": {
            "type": "string",
            "example": "4d69ed37-7f7f-4318-8b9a-62b3a2469ed5",
            "format": "uuid"
          },
          "violations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ApiViolationResponse" }
          }
        },
        "required": ["code", "message", "requestId"]
      },
      "ApiErrorResponse": {
        "type": "object",
        "properties": {
          "error": { "$ref": "#/components/schemas/ApiErrorBodyResponse" }
        },
        "required": ["error"]
      },
      "LivenessResponse": {
        "type": "object",
        "properties": { "status": { "type": "string", "example": "ok" } },
        "required": ["status"]
      },
      "DependencyStatusResponse": {
        "type": "object",
        "properties": {
          "postgresql": { "type": "string", "example": "up", "enum": ["up"] },
          "redis": { "type": "string", "example": "up", "enum": ["up"] }
        },
        "required": ["postgresql", "redis"]
      },
      "ReadinessResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "ready" },
          "dependencies": {
            "$ref": "#/components/schemas/DependencyStatusResponse"
          }
        },
        "required": ["status", "dependencies"]
      }
    }
  }
}
