  "constraints": [
    {
      "schema": "mymoneymap",
      "relation": "email_verification_tokens",
      "name": "email_verification_consumed_check",
      "definition": "CHECK (consumed_at IS NULL OR consumed_at >= created_at)"
    },
    {
      "schema": "mymoneymap",
      "relation": "email_verification_tokens",
      "name": "email_verification_expiry_check",
      "definition": "CHECK (expires_at > created_at)"
    },
    {
      "schema": "mymoneymap",
      "relation": "email_verification_tokens",
      "name": "email_verification_tokens_pkey",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "schema": "mymoneymap",
      "relation": "email_verification_tokens",
      "name": "email_verification_tokens_token_hash_key",
      "definition": "UNIQUE (token_hash)"
    },
    {
      "schema": "mymoneymap",
      "relation": "email_verification_tokens",
      "name": "email_verification_tokens_user_id_fkey",
      "definition": "FOREIGN KEY (user_id) REFERENCES mymoneymap.users(id) ON DELETE CASCADE"
    },
    {
      "schema": "mymoneymap",
      "relation": "idempotency_keys",
      "name": "idempotency_keys_completion_check",
      "definition": "CHECK (status::text = 'in_progress'::text AND response IS NULL AND completed_at IS NULL OR status::text = 'completed'::text AND response IS NOT NULL AND jsonb_typeof(response) = 'object'::text AND completed_at IS NOT NULL)"
    },
    {
      "schema": "mymoneymap",
      "relation": "idempotency_keys",
      "name": "idempotency_keys_key_hash_check",
      "definition": "CHECK (key_hash ~ '^[0-9a-f]{64}$'::text)"
    },
    {
      "schema": "mymoneymap",
      "relation": "idempotency_keys",
      "name": "idempotency_keys_operation_check",
      "definition": "CHECK (operation::text ~ '^[a-z][a-z0-9._:-]{0,127}$'::text)"
    },
    {
      "schema": "mymoneymap",
      "relation": "idempotency_keys",
      "name": "idempotency_keys_pkey",
      "definition": "PRIMARY KEY (scope_id, operation, key_hash)"
    },
    {
      "schema": "mymoneymap",
      "relation": "idempotency_keys",
      "name": "idempotency_keys_request_hash_check",
      "definition": "CHECK (request_hash ~ '^[0-9a-f]{64}$'::text)"
    },
    {
      "schema": "mymoneymap",
      "relation": "idempotency_keys",
      "name": "idempotency_keys_status_check",
      "definition": "CHECK (status::text = ANY (ARRAY['in_progress'::character varying, 'completed'::character varying]::text[]))"
    },
    {
      "schema": "mymoneymap",
      "relation": "journal_entries",
      "name": "journal_entries_actor_check",
      "definition": "CHECK (actor_user_id = user_id)"
    },
    {
      "schema": "mymoneymap",
      "relation": "journal_entries",
      "name": "journal_entries_actor_user_id_fkey",
      "definition": "FOREIGN KEY (actor_user_id) REFERENCES mymoneymap.users(id) ON DELETE RESTRICT"
    },
    {
      "schema": "mymoneymap",
      "relation": "journal_entries",
      "name": "journal_entries_balance_check",
      "definition": "TRIGGER DEFERRABLE INITIALLY DEFERRED"
    },
    {
      "schema": "mymoneymap",
      "relation": "journal_entries",
      "name": "journal_entries_category_check",
      "definition": "CHECK (category_id IS NULL OR (economic_type::text = ANY (ARRAY['external_income'::character varying, 'external_expense'::character varying, 'fee'::character varying]::text[])))"
    },
    {
      "schema": "mymoneymap",
      "relation": "journal_entries",
      "name": "journal_entries_correction_link_check",
      "definition": "CHECK (NOT (reverses_entry_id IS NOT NULL AND replaces_entry_id IS NOT NULL))"
    },
    {
      "schema": "mymoneymap",
      "relation": "journal_entries",
      "name": "journal_entries_economic_type_check",
      "definition": "CHECK (economic_type::text = ANY (ARRAY['external_income'::character varying, 'external_expense'::character varying, 'internal_transfer'::character varying, 'adjustment'::character varying, 'fee'::character varying, 'interest'::character varying, 'dividend'::character varying, 'loan_repayment'::character varying, 'trade_cash'::character varying]::text[]))"
    },
    {
      "schema": "mymoneymap",
      "relation": "journal_entries",
      "name": "journal_entries_id_user_unique",
      "definition": "UNIQUE (id, user_id)"
    },
    {
      "schema": "mymoneymap",
      "relation": "journal_entries",
      "name": "journal_entries_idempotency_hash_check",
      "definition": "CHECK (idempotency_key_hash ~ '^[0-9a-f]{64}$'::text)"
    },
    {
      "schema": "mymoneymap",
      "relation": "journal_entries",
      "name": "journal_entries_note_check",
      "definition": "CHECK (note IS NULL OR char_length(btrim(note::text)) >= 1 AND char_length(btrim(note::text)) <= 1000)"
    },
    {
      "schema": "mymoneymap",
      "relation": "journal_entries",
      "name": "journal_entries_pkey",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "schema": "mymoneymap",
      "relation": "journal_entries",
      "name": "journal_entries_replaces_owner_fk",
      "definition": "FOREIGN KEY (replaces_entry_id, user_id) REFERENCES mymoneymap.journal_entries(id, user_id) ON DELETE RESTRICT"
    },
    {
      "schema": "mymoneymap",
      "relation": "journal_entries",
      "name": "journal_entries_reverses_owner_fk",
      "definition": "FOREIGN KEY (reverses_entry_id, user_id) REFERENCES mymoneymap.journal_entries(id, user_id) ON DELETE RESTRICT"
    },
    {
      "schema": "mymoneymap",
      "relation": "journal_entries",
      "name": "journal_entries_source_idempotency_unique",
      "definition": "UNIQUE (user_id, source_module, idempotency_key_hash)"
    },
