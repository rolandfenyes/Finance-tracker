      "nullable": false,
      "default": null
    },
    {
      "schema": "mymoneymap",
      "relation": "idempotency_keys",
      "name": "operation",
      "type": "character varying(128)",
      "nullable": false,
      "default": null
    },
    {
      "schema": "mymoneymap",
      "relation": "idempotency_keys",
      "name": "key_hash",
      "type": "character(64)",
      "nullable": false,
      "default": null
    },
    {
      "schema": "mymoneymap",
      "relation": "idempotency_keys",
      "name": "request_hash",
      "type": "character(64)",
      "nullable": false,
      "default": null
    },
    {
      "schema": "mymoneymap",
      "relation": "idempotency_keys",
      "name": "status",
      "type": "character varying(16)",
      "nullable": false,
      "default": null
    },
    {
      "schema": "mymoneymap",
      "relation": "idempotency_keys",
      "name": "response",
      "type": "jsonb",
      "nullable": true,
      "default": null
    },
    {
      "schema": "mymoneymap",
      "relation": "idempotency_keys",
      "name": "created_at",
      "type": "timestamp with time zone",
      "nullable": false,
      "default": null
    },
    {
      "schema": "mymoneymap",
      "relation": "idempotency_keys",
      "name": "completed_at",
      "type": "timestamp with time zone",
      "nullable": true,
      "default": null
    },
    {
      "schema": "mymoneymap_meta",
      "relation": "kysely_migration",
      "name": "name",
      "type": "character varying(255)",
      "nullable": false,
      "default": null
    },
    {
      "schema": "mymoneymap_meta",
      "relation": "kysely_migration",
      "name": "timestamp",
      "type": "character varying(255)",
      "nullable": false,
      "default": null
    },
    {
      "schema": "mymoneymap_meta",
      "relation": "kysely_migration_lock",
      "name": "id",
