  "constraints": [
    {
      "schema": "mymoneymap",
      "relation": "email_verification_tokens",
      "name": "email_verification_consumed_check",
      "definition": "CHECK (consumed_at IS NULL OR consumed_at >= created_at)"
    },
    {
      "schema": "mymoneymap",
      "relation": "email_verification_tokens",
      "name": "email_verification_expiry_check",
      "definition": "CHECK (expires_at > created_at)"
    },
    {
      "schema": "mymoneymap",
      "relation": "email_verification_tokens",
      "name": "email_verification_tokens_pkey",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "schema": "mymoneymap",
      "relation": "email_verification_tokens",
      "name": "email_verification_tokens_token_hash_key",
      "definition": "UNIQUE (token_hash)"
    },
    {
      "schema": "mymoneymap",
      "relation": "email_verification_tokens",
      "name": "email_verification_tokens_user_id_fkey",
      "definition": "FOREIGN KEY (user_id) REFERENCES mymoneymap.users(id) ON DELETE CASCADE"
    },
    {
      "schema": "mymoneymap",
      "relation": "idempotency_keys",
      "name": "idempotency_keys_completion_check",
      "definition": "CHECK (status::text = 'in_progress'::text AND response IS NULL AND completed_at IS NULL OR status::text = 'completed'::text AND response IS NOT NULL AND jsonb_typeof(response) = 'object'::text AND completed_at IS NOT NULL)"
    },
    {
      "schema": "mymoneymap",
      "relation": "idempotency_keys",
      "name": "idempotency_keys_key_hash_check",
      "definition": "CHECK (key_hash ~ '^[0-9a-f]{64}$'::text)"
    },
    {
      "schema": "mymoneymap",
      "relation": "idempotency_keys",
      "name": "idempotency_keys_operation_check",
      "definition": "CHECK (operation::text ~ '^[a-z][a-z0-9._:-]{0,127}$'::text)"
    },
    {
      "schema": "mymoneymap",
      "relation": "idempotency_keys",
      "name": "idempotency_keys_pkey",
      "definition": "PRIMARY KEY (scope_id, operation, key_hash)"
    },
    {
      "schema": "mymoneymap",
      "relation": "idempotency_keys",
      "name": "idempotency_keys_request_hash_check",
      "definition": "CHECK (request_hash ~ '^[0-9a-f]{64}$'::text)"
    },
    {
      "schema": "mymoneymap",
      "relation": "idempotency_keys",
      "name": "idempotency_keys_status_check",
      "definition": "CHECK (status::text = ANY (ARRAY['in_progress'::character varying, 'completed'::character varying]::text[]))"
    },
    {
      "schema": "mymoneymap",
      "relation": "login_audit_events",
      "name": "login_audit_events_pkey",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "schema": "mymoneymap",
      "relation": "login_audit_events",
      "name": "login_audit_events_user_id_fkey",
      "definition": "FOREIGN KEY (user_id) REFERENCES mymoneymap.users(id) ON DELETE SET NULL"
    },
    {
      "schema": "mymoneymap",
      "relation": "login_audit_events",
      "name": "login_audit_method_check",
      "definition": "CHECK (method::text = ANY (ARRAY['password'::character varying, 'passkey'::character varying]::text[]))"
    },
    {
      "schema": "mymoneymap",
      "relation": "login_audit_events",
      "name": "login_audit_outcome_check",
      "definition": "CHECK (outcome::text = ANY (ARRAY['success'::character varying, 'failure'::character varying, 'throttled'::character varying]::text[]))"
    },
    {
      "schema": "mymoneymap",
      "relation": "passkeys",
      "name": "passkeys_counter_check",
      "definition": "CHECK (counter >= 0)"
    },
    {
      "schema": "mymoneymap",
      "relation": "passkeys",
      "name": "passkeys_credential_id_key",
      "definition": "UNIQUE (credential_id)"
    },
    {
      "schema": "mymoneymap",
      "relation": "passkeys",
      "name": "passkeys_label_check",
      "definition": "CHECK (char_length(btrim(label::text)) >= 1 AND char_length(btrim(label::text)) <= 100)"
    },
    {
      "schema": "mymoneymap",
      "relation": "passkeys",
      "name": "passkeys_pkey",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "schema": "mymoneymap",
      "relation": "passkeys",
      "name": "passkeys_revision_check",
      "definition": "CHECK (revision >= 0)"
    },
    {
      "schema": "mymoneymap",
      "relation": "passkeys",
      "name": "passkeys_user_id_fkey",
      "definition": "FOREIGN KEY (user_id) REFERENCES mymoneymap.users(id) ON DELETE CASCADE"
    },
    {
      "schema": "mymoneymap",
      "relation": "users",
      "name": "users_email_normalized_check",
      "definition": "CHECK (email::text = lower(btrim(email::text)))"
    },
    {
      "schema": "mymoneymap",
      "relation": "users",
      "name": "users_name_check",
      "definition": "CHECK (char_length(btrim(full_name::text)) >= 1 AND char_length(btrim(full_name::text)) <= 200)"
    },
    {
      "schema": "mymoneymap",
      "relation": "users",
      "name": "users_pkey",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "schema": "mymoneymap",
      "relation": "users",
      "name": "users_role_check",
      "definition": "CHECK (role::text = ANY (ARRAY['free'::character varying, 'premium'::character varying, 'admin'::character varying]::text[]))"
    },
    {
      "schema": "mymoneymap",
      "relation": "users",
      "name": "users_status_check",
      "definition": "CHECK (status::text = ANY (ARRAY['active'::character varying, 'inactive'::character varying]::text[]))"
    },
    {
      "schema": "mymoneymap_meta",
      "relation": "kysely_migration",
