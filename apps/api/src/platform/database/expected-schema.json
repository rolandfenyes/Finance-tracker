    }
  ],
  "constraints": [
    {
      "schema": "mymoneymap",
      "relation": "idempotency_keys",
      "name": "idempotency_keys_completion_check",
      "definition": "CHECK (status::text = 'in_progress'::text AND response IS NULL AND completed_at IS NULL OR status::text = 'completed'::text AND response IS NOT NULL AND jsonb_typeof(response) = 'object'::text AND completed_at IS NOT NULL)"
    },
    {
      "schema": "mymoneymap",
      "relation": "idempotency_keys",
      "name": "idempotency_keys_key_hash_check",
      "definition": "CHECK (key_hash ~ '^[0-9a-f]{64}$'::text)"
    },
    {
      "schema": "mymoneymap",
      "relation": "idempotency_keys",
      "name": "idempotency_keys_operation_check",
      "definition": "CHECK (operation::text ~ '^[a-z][a-z0-9._:-]{0,127}$'::text)"
    },
    {
      "schema": "mymoneymap",
      "relation": "idempotency_keys",
      "name": "idempotency_keys_pkey",
      "definition": "PRIMARY KEY (scope_id, operation, key_hash)"
    },
    {
      "schema": "mymoneymap",
      "relation": "idempotency_keys",
      "name": "idempotency_keys_request_hash_check",
      "definition": "CHECK (request_hash ~ '^[0-9a-f]{64}$'::text)"
    },
    {
      "schema": "mymoneymap",
      "relation": "idempotency_keys",
      "name": "idempotency_keys_status_check",
      "definition": "CHECK (status::text = ANY (ARRAY['in_progress'::character varying, 'completed'::character varying]::text[]))"
    },
    {
      "schema": "mymoneymap_meta",
      "relation": "kysely_migration",
      "name": "kysely_migration_pkey",
      "definition": "PRIMARY KEY (name)"
    },
    {
      "schema": "mymoneymap_meta",
      "relation": "kysely_migration_lock",
      "name": "kysely_migration_lock_pkey",
      "definition": "PRIMARY KEY (id)"
    }
  ],
  "indexes": [
    {
      "schema": "mymoneymap",
      "relation": "idempotency_keys",
      "name": "idempotency_keys_pkey",
      "definition": "CREATE UNIQUE INDEX idempotency_keys_pkey ON mymoneymap.idempotency_keys USING btree (scope_id, operation, key_hash)"
    },
    {
      "schema": "mymoneymap_meta",
      "relation": "kysely_migration",
      "name": "kysely_migration_pkey",
      "definition": "CREATE UNIQUE INDEX kysely_migration_pkey ON mymoneymap_meta.kysely_migration USING btree (name)"
    },
    {
      "schema": "mymoneymap_meta",
      "relation": "kysely_migration_lock",
      "name": "kysely_migration_lock_pkey",
      "definition": "CREATE UNIQUE INDEX kysely_migration_lock_pkey ON mymoneymap_meta.kysely_migration_lock USING btree (id)"
    }
  ]
}
