{
  "name": "web-core",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/web/core/src",
  "prefix": "mmm",
  "projectType": "library",
  "tags": ["scope:web", "type:core"],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/web/core/ng-package.json",
        "tsConfig": "libs/web/core/tsconfig.lib.build.json"
      },
      "configurations": {
        "production": { "tsConfig": "libs/web/core/tsconfig.lib.prod.json" },
        "development": {}
      }
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": { "watch": false }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/web/core/tsconfig.lib.json --noEmit && tsc -p libs/web/core/tsconfig.spec.json --noEmit"
      }
    },
    "lint": { "executor": "@nx/eslint:lint" }
  }
}
