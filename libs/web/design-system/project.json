{
  "name": "web-design-system",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/web/design-system/src",
  "prefix": "mmm",
  "projectType": "library",
  "tags": ["scope:web", "type:design-system"],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/web/design-system/ng-package.json",
        "tsConfig": "libs/web/design-system/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/web/design-system/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "watch": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/web/design-system/tsconfig.lib.json --noEmit && tsc -p libs/web/design-system/tsconfig.spec.json --noEmit"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
