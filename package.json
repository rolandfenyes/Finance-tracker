{
  "name": "mymoneymap",
  "version": "0.0.0",
  "private": true,
  "description": "MyMoneyMap modular-monolith workspace",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": "22.13.1",
    "pnpm": "10.30.3"
  },
  "pnpm": {
    "overrides": {
      "js-yaml": "5.2.2"
    }
  },
  "scripts": {
    "build": "nx run-many -t build",
    "dev": "nx run api:serve",
    "start": "nx run api:start",
    "format": "prettier --write \"apps/**/*.{ts,json,md}\" \"libs/**/*.{ts,json,md}\" \"*.{json,yml,yaml}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"apps/**/*.{ts,json,md}\" \"libs/**/*.{ts,json,md}\" \"*.{json,yml,yaml}\" \".github/**/*.yml\"",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "test:integration": "nx run-many -t test-integration",
    "db:migrations:check": "nx run api:db-migrations-check",
    "db:migrate": "nx run api:db-migrate",
    "db:rollback": "nx run api:db-rollback",
    "db:status": "nx run api:db-status",
    "db:drift": "nx run api:db-drift",
    "db:fingerprint": "nx run api:db-fingerprint",
    "openapi:generate": "nx run api:openapi-generate",
    "openapi:check": "nx run api:openapi-check",
    "security:audit": "pnpm audit --prod --audit-level high",
    "deps:up": "docker compose --env-file .env.backend -f compose.backend.yml up -d --wait",
    "deps:down": "docker compose --env-file .env.backend -f compose.backend.yml down"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "11.1.28",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.1",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.1",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.9.0",
    "jest": "29.7.0",
    "nx": "23.1.0",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  },
  "dependencies": {
    "decimal.js": "10.6.0"
  }
}
