{
  "name": "mymoneymap",
  "version": "0.0.0",
  "private": true,
  "description": "MyMoneyMap modular-monolith workspace",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": "22.13.1",
    "pnpm": "10.30.3"
  },
  "pnpm": {
    "overrides": {
      "flatted": "3.4.2",
      "handlebars": "4.7.9",
      "js-yaml": "5.2.2",
      "lodash": "4.18.0",
      "node-forge": "1.4.0",
      "underscore": "1.13.8",
      "uuid": "11.1.1"
    }
  },
  "scripts": {
    "build": "nx run-many -t build",
    "dev": "nx run api:serve",
    "dev:web": "nx run web-app:serve",
    "start": "nx run api:start",
    "format": "prettier --write \"apps/**/*.{ts,mts,mjs,json,md,html,scss,css}\" \"libs/**/*.{ts,json,md,html,scss}\" \"scripts/**/*.mjs\" \"postman/**/*.{json,md}\" \"docs/backend-implementation/steps/22-postman-backend-freeze/BACKEND-COMPLETION-REPORT.md\" \"*.{json,yml,yaml,mjs}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"apps/**/*.{ts,mts,mjs,json,md,html,scss,css}\" \"libs/**/*.{ts,json,md,html,scss}\" \"scripts/**/*.mjs\" \"postman/**/*.{json,md}\" \"docs/backend-implementation/steps/22-postman-backend-freeze/BACKEND-COMPLETION-REPORT.md\" \"*.{json,yml,yaml,mjs}\" \".github/**/*.yml\"",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "test:web": "nx run-many -t test -p web-app web-core web-design-system web-shared",
    "test:e2e": "playwright test --config apps/web-app-e2e/playwright.config.mts",
    "test:integration": "nx run-many -t test-integration",
    "db:migrations:check": "nx run api:db-migrations-check",
    "db:migrate": "nx run api:db-migrate",
    "db:rollback": "nx run api:db-rollback",
    "db:status": "nx run api:db-status",
    "db:drift": "nx run api:db-drift",
    "db:fingerprint": "nx run api:db-fingerprint",
    "openapi:generate": "nx run api:openapi-generate",
    "openapi:check": "nx run api:openapi-check",
    "api-client:generate": "ng-openapi-gen",
    "api-client:check": "node scripts/contracts/check-generated-artifact.mjs angular",
    "postman:generate": "node scripts/contracts/generate-postman.mjs",
    "postman:check": "node scripts/contracts/check-generated-artifact.mjs postman",
    "postman:acceptance": "node scripts/contracts/run-postman-acceptance.mjs",
    "route-coverage:generate": "node scripts/contracts/generate-route-coverage.mjs",
    "route-coverage:check": "node scripts/contracts/check-route-coverage.mjs",
    "contracts:check": "pnpm openapi:check && pnpm api-client:check && pnpm postman:check && pnpm route-coverage:check",
    "security:audit": "pnpm audit --prod --audit-level high",
    "security:sbom": "node scripts/generate-backend-sbom.mjs",
    "security:sbom:check": "node scripts/generate-backend-sbom.mjs --check",
    "load:backend-reads": "node scripts/load/backend-read-paths.mjs",
    "operations:restore-rehearsal": "node scripts/operations/rehearse-backup-restore.mjs",
    "deps:up": "docker compose --env-file .env.backend -f compose.backend.yml up -d --wait",
    "deps:down": "docker compose --env-file .env.backend -f compose.backend.yml down"
  },
  "devDependencies": {
    "@angular-devkit/core": "21.2.19",
    "@angular-devkit/schematics": "21.2.19",
    "@angular/build": "21.2.19",
    "@angular/common": "21.2.19",
    "@angular/compiler": "21.2.19",
    "@angular/compiler-cli": "21.2.19",
    "@angular/core": "21.2.19",
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "11.1.28",
    "@nx/angular": "23.1.0",
    "@nx/devkit": "23.1.0",
    "@nx/eslint-plugin": "23.1.0",
    "@nx/js": "23.1.0",
    "@nx/playwright": "23.1.0",
    "@nx/web": "23.1.0",
    "@playwright/test": "^1.37.0",
    "@schematics/angular": "21.2.19",
    "@swc/helpers": "~0.5.18",
    "@tailwindcss/postcss": "4.3.3",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.1",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.1",
    "@typescript-eslint/utils": "^8.58.0",
    "angular-eslint": "^21.2.0",
    "autoprefixer": "^10.4.0",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "^1.6.2",
    "fast-check": "4.9.0",
    "jest": "29.7.0",
    "jsdom": "^27.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "newman": "6.2.2",
    "ng-openapi-gen": "1.0.5",
    "ng-packagr": "~21.2.0",
    "nx": "23.1.0",
    "postcss": "^8.4.5",
    "prettier": "3.9.6",
    "rxjs": "7.8.2",
    "supertest": "7.2.2",
    "tailwindcss": "4.3.3",
    "ts-jest": "29.4.12",
    "tslib": "2.8.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "^4.0.8",
    "zone.js": "0.16.2"
  },
  "dependencies": {
    "@angular/animations": "21.2.19",
    "@angular/cdk": "21.2.14",
    "@angular/forms": "21.2.19",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.19",
    "@angular/router": "21.2.19",
    "@jsverse/transloco": "8.4.0",
    "decimal.js": "10.6.0",
    "echarts": "6.1.0",
    "ngx-echarts": "21.0.0",
    "nodemailer": "9.0.3"
  }
}
